{
  "name": "@llm-newsletter-kit/core",
  "private": false,
  "type": "module",
  "version": "3.2.3",
  "description": "An extensible framework to automate your entire newsletter workflow. Handles data collection, LLM-based content analysis, and email generation, letting you focus on your unique domain logic.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "release": "node scripts/release.mjs none",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "TEST_MODE=ci vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "lint:ci": "eslint --quiet ./src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,mdx}\"",
    "playground": "node --import @oxc-node/core/register",
    "playground:verify-prompts": "node --import @oxc-node/core/register playground/verify-prompts.ts",
    "playground:classify-tags": "node --import @oxc-node/core/register playground/classify-tags.ts",
    "playground:analyze-images": "node --import @oxc-node/core/register playground/analyze-images.ts",
    "playground:determine-importance": "node --import @oxc-node/core/register playground/determine-importance.ts",
    "playground:generate-newsletter": "node --import @oxc-node/core/register playground/generate-newsletter.ts"
  },
  "author": "kimhongyeon",
  "license": "Apache-2.0",
  "dependencies": {
    "@langchain/core": "^1.5.0",
    "ai": "^7.0.179",
    "es-toolkit": "^1.53.2",
    "jsdom": "^31.0.1",
    "juice": "^12.2.6",
    "safe-markdown2html": "^1.0.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/togetherai": "^3.0.96",
    "@eslint/js": "^10.0.1",
    "@oxc-node/core": "^1.0.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/expect": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.10.1",
    "tsdown": "0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heripo-lab/llm-newsletter-kit-core"
  },
  "bugs": {
    "url": "https://github.com/heripo-lab/llm-newsletter-kit-core/issues"
  },
  "homepage": "https://github.com/heripo-lab/llm-newsletter-kit-core",
  "keywords": [
    "llm",
    "newsletter",
    "ai",
    "automation",
    "framework",
    "toolkit",
    "large-language-model",
    "gpt",
    "email-automation",
    "content-aggregation",
    "content-generation",
    "summarization",
    "web-scraping",
    "parsing",
    "extensible",
    "pluggable",
    "workflow-automation",
    "developer-tools",
    "nodejs"
  ],
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
