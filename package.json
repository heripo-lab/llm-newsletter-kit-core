{
  "name": "@llm-newsletter-kit/core",
  "private": false,
  "type": "module",
  "version": "3.0.2",
  "description": "An extensible framework to automate your entire newsletter workflow. Handles data collection, LLM-based content analysis, and email generation, letting you focus on your unique domain logic.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && rollup -c",
    "prepublishOnly": "npm run build",
    "preversion": "npm run build",
    "postversion": "git push --follow-tags",
    "release": "npm publish --access public",
    "release:patch": "npm version patch && npm publish --access public",
    "release:minor": "npm version minor && npm publish --access public",
    "release:major": "npm version major && npm publish --access public",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "TEST_MODE=ci vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "lint:ci": "eslint --quiet ./src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,mdx}\"",
    "playground": "tsx",
    "playground:verify-prompts": "tsx playground/verify-prompts.ts",
    "playground:classify-tags": "tsx playground/classify-tags.ts",
    "playground:analyze-images": "tsx playground/analyze-images.ts",
    "playground:determine-importance": "tsx playground/determine-importance.ts",
    "playground:generate-newsletter": "tsx playground/generate-newsletter.ts"
  },
  "author": "kimhongyeon",
  "license": "Apache-2.0",
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "ai": "^7.0.57",
    "es-toolkit": "^1.50.0",
    "jsdom": "^30.0.1",
    "juice": "^12.1.2",
    "safe-markdown2html": "^1.0.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.35",
    "@ai-sdk/google": "^4.0.38",
    "@ai-sdk/openai": "^4.0.35",
    "@ai-sdk/togetherai": "^3.0.27",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/expect": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-typescript2": "^0.37.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heripo-lab/llm-newsletter-kit-core"
  },
  "bugs": {
    "url": "https://github.com/heripo-lab/llm-newsletter-kit-core/issues"
  },
  "homepage": "https://github.com/heripo-lab/llm-newsletter-kit-core",
  "keywords": [
    "llm",
    "newsletter",
    "ai",
    "automation",
    "framework",
    "toolkit",
    "large-language-model",
    "gpt",
    "email-automation",
    "content-aggregation",
    "content-generation",
    "summarization",
    "web-scraping",
    "parsing",
    "extensible",
    "pluggable",
    "workflow-automation",
    "developer-tools",
    "nodejs"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true
  }
}
